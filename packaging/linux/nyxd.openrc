#!/sbin/openrc-run
# shellcheck shell=sh disable=SC1091,SC2034 # sourced by openrc-run, which reads command_args
# nyxd OpenRC service (/etc/init.d/nyxd), enabled by the nyxd packages and
# install.sh. Flags: NYXD_OPTS in /etc/default/nyxd or /etc/conf.d/nyxd.

name="nyxd"
description="lightweight OCI container orchestrator"
command="/usr/bin/nyxd"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="${output_log:-/var/log/nyxd.log}"
error_log="${error_log:-/var/log/nyxd.log}"
retry="TERM/60/KILL/5"

start_pre() {
	[ -r /etc/default/nyxd ] && . /etc/default/nyxd
	command_args="-socket-group nyx ${NYXD_OPTS:--log-level info}"
}

depend() {
	need net localmount
	after firewall
}
