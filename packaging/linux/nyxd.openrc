#!/sbin/openrc-run
# Installed by the nyxd Alpine package as /etc/init.d/nyxd:
#   rc-update add nyxd default && rc-service nyxd start
# Extra flags go in /etc/conf.d/nyxd: NYXD_OPTS="-log-level debug"

name="nyxd"
description="lightweight OCI container orchestrator"
command="/usr/bin/nyxd"
command_args="-socket-group nyx ${NYXD_OPTS:--log-level info}"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/nyxd.log"
error_log="/var/log/nyxd.log"
retry="TERM/60/KILL/5"

depend() {
	need net
	after firewall
}
