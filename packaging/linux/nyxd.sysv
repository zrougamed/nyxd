#!/bin/sh
### BEGIN INIT INFO
# Provides:          nyxd
# Required-Start:    $remote_fs $network $syslog
# Required-Stop:     $remote_fs $network $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: nyxd container orchestrator
# Description:       nyxd: crun plus a small control plane (no Docker/Podman).
### END INIT INFO
# SysV init script (/etc/init.d/nyxd) for systems without systemd, OpenRC or
# runit. Flags: NYXD_OPTS in /etc/default/nyxd.

NAME=nyxd
DAEMON=/usr/bin/nyxd
PIDFILE=/run/nyxd.pid
LOG=/var/log/nyxd.log
NYXD_OPTS="-log-level info"
# shellcheck source=/dev/null
[ -r /etc/default/nyxd ] && . /etc/default/nyxd
[ -x "$DAEMON" ] || exit 0

running() {
	[ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

start() {
	if running; then
		echo "$NAME is already running"
		return 0
	fi
	printf 'Starting %s... ' "$NAME"
	# shellcheck disable=SC2086 # NYXD_OPTS is a list of flags
	nohup "$DAEMON" -socket-group nyx $NYXD_OPTS >>"$LOG" 2>&1 &
	echo $! >"$PIDFILE"
	sleep 1
	if running; then echo "ok"; else echo "failed (see $LOG)"; return 1; fi
}

stop() {
	if ! running; then
		echo "$NAME is not running"
		rm -f "$PIDFILE"
		return 0
	fi
	printf 'Stopping %s... ' "$NAME"
	pid=$(cat "$PIDFILE")
	kill -TERM "$pid"
	i=0
	while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 60 ]; do
		sleep 1
		i=$((i + 1))
	done
	kill -0 "$pid" 2>/dev/null && kill -KILL "$pid"
	rm -f "$PIDFILE"
	echo "ok"
}

case "$1" in
start) start ;;
stop) stop ;;
restart | force-reload)
	stop
	start
	;;
status)
	if running; then
		echo "$NAME is running (pid $(cat "$PIDFILE"))"
	else
		echo "$NAME is not running"
		exit 3
	fi
	;;
*)
	echo "Usage: $0 {start|stop|restart|status}" >&2
	exit 2
	;;
esac
