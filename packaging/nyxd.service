[Unit]
Description=nyxd – Lightweight OCI Container Orchestrator
Documentation=https://github.com/zrougamed/nyxd
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/nyxd \
  -f /etc/nyxd/compose.yaml \
  -state /var/lib/nyxd \
  -cni-conf /etc/cni/net.d \
  -cni-path /opt/cni/bin \
  -crun /usr/bin/crun \
  -log-level info

ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s

# Security hardening
NoNewPrivileges=no     # nyxd needs to set up namespaces for containers
# Restrict to real root — container setup needs real capabilities
AmbientCapabilities=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_MKNOD CAP_CHOWN \
                    CAP_DAC_OVERRIDE CAP_SETGID CAP_SETUID CAP_SETPCAP \
                    CAP_NET_BIND_SERVICE CAP_SYS_PTRACE
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_MKNOD CAP_CHOWN \
                      CAP_DAC_OVERRIDE CAP_SETGID CAP_SETUID CAP_SETPCAP \
                      CAP_NET_BIND_SERVICE CAP_SYS_PTRACE

# Protect host paths
ProtectHostname=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes

# Limit process count
LimitNPROC=4096
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nyxd

[Install]
WantedBy=multi-user.target
